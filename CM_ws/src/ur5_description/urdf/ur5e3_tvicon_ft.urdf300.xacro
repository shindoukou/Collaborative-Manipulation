<?xml version="1.0"?>
<robot name="ur5e_ur3" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ur5_description)/urdf/left_ur5e_joint_limited_robot.urdf.xacro" />
  <xacro:include filename="$(find ur5_description)/urdf/right_ur3_joint_limited_robot.urdf.xacro" /> 
  <xacro:include filename="$(find robotiq_sensor_tf)/urdf/right_ur3_joint_limited_robot.urdf.xacro" />   
  
  <xacro:robotiq_ft300 parent="robot_flange_link" prefix="">
                <origin xyz="0 0 0" rpy="0 0 0"/> 
  </xacro:robotiq_ft300>
  <link name="world" />

  <joint name="left_world_joint" type="fixed">
    <parent link="world" />
    <child link = "left_base_link" />
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>
  <joint name="right_world_joint" type="fixed">
    <parent link="world" />
    <child link = "right_base_link" />
    <origin xyz="0.0076 0.467655 -0.001366" rpy="0.0 0.0 3.1415" />
  </joint>
  <gazebo>
    <plugin filename="libgazebo_ros_control.so" name="ros_control">
      <!--robotNamespace>/</robotNamespace>
      <legacyModeNS>true</legacyModeNS-->
      <!--robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType-->
    </plugin>
  </gazebo>
</robot>
