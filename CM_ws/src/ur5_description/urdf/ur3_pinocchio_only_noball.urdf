  </link>

  <link name="right_ft300_mounting_plate">
    <visual>
      <geometry>
        <mesh filename="/home/mas-2/catkin_gripper/src/robotiq-noetic-devel/robotiq_ft_sensor/meshes/visual/mountings/robotiq_ft300-G-062-COUPLING_G-50-4M6-1D6_20181119.STL" scale="1 1 1" />
      </geometry>
      <material name="Robotiq-Grey"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="/home/mas-2/catkin_gripper/src/robotiq-noetic-devel/robotiq_ft_sensor/meshes/collision/mountings/robotiq_ft300-G-062-COUPLING_G-50-4M6-1D6_20181119.STL" scale="1 1 1" />
      </geometry>
    </collision>
  </link>

  <link name="right_ft300_sensor">
    <inertial>
      <mass value="0.3" />
      <origin xyz="0 0 -0.017" rpy="0 0 0" />
      <inertia ixx="0.000262" ixy="0" ixz="1e-06" iyy="0.000265" iyz="1e-06" izz="0.000219" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="/home/mas-2/catkin_gripper/src/robotiq-noetic-devel/robotiq_ft_sensor/meshes/visual/robotiq_ft300.STL" scale="1 1 1" />
      </geometry>
      <material name="Robotiq-Black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="/home/mas-2/catkin_gripper/src/robotiq-noetic-devel/robotiq_ft_sensor/meshes/collision/robotiq_ft300.STL" scale="1 1 1" />
      </geometry>
    </collision>
  </link>

  <link name="right_tool0" />

  <!-- Obstacle Boxes (fixed to world, for collision only) -->
  <link name="obs_box">
    <visual><geometry><box size="0.05 0.48 0.48"/></geometry></visual>
    <collision><geometry><box size="0.05 0.48 0.48"/></geometry></collision>
  </link>
  <link name="obs_box_platform">
    <visual><geometry><box size="0.2 0.1 0.02"/></geometry></visual>
    <collision><geometry><box size="0.2 0.1 0.02"/></geometry></collision>
  </link>
  <link name="obs_box_son">
    <visual><geometry><box size="0.05 0.06 0.2"/></geometry></visual>
    <collision><geometry><box size="0.05 0.06 0.2"/></geometry></collision>
  </link>
  <link name="other_box_1">
    <visual><geometry><box size="0.35 0.6 0.48"/></geometry></visual>
    <collision><geometry><box size="0.35 0.6 0.48"/></geometry></collision>
  </link>

  <!-- Joints -->

  <!-- Base fixed to world -->
  <joint name="right_world_joint" type="fixed">
    <parent link="world"/>
    <child link="right_base_link"/>
    <origin rpy="0.0 0.0 3.1415926" xyz="0.0076 0.467655 -0.001366"/>
  </joint>

  <joint name="right_base_link-base_fixed_joint" type="fixed">
    <parent link="right_base_link"/>
    <child link="right_base"/>
    <origin xyz="0 0 0" rpy="0 0 -3.14159"/>
  </joint>

  <!-- UR3 Active Joints (6 revolute) -->
  <joint name="right_shoulder_pan_joint" type="revolute">
    <parent link="right_base_link"/>
    <child link="right_shoulder_link"/>
    <origin xyz="0 0 0.1519" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="330" velocity="2.16" lower="-3.14159" upper="3.14159"/>
  </joint>

  <joint name="right_shoulder_lift_joint" type="revolute">
    <parent link="right_shoulder_link"/>
    <child link="right_upper_arm_link"/>
    <origin xyz="0 0.1198 0" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="330" velocity="2.16" lower="-3.14159" upper="3.14159"/>
  </joint>

  <joint name="right_elbow_joint" type="revolute">
    <parent link="right_upper_arm_link"/>
    <child link="right_forearm_link"/>
    <origin xyz="0 -0.0925 0.24365" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="150" velocity="3.15" lower="-3.14159" upper="3.14159"/>
  </joint>

  <joint name="right_wrist_1_joint" type="revolute">
    <parent link="right_forearm_link"/>
    <child link="right_wrist_1_link"/>
    <origin xyz="0 0 0.21325" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="54" velocity="3.2" lower="-3.14159" upper="3.14159"/>
  </joint>

  <joint name="right_wrist_2_joint" type="revolute">
    <parent link="right_wrist_1_link"/>
    <child link="right_wrist_2_link"/>
    <origin xyz="0 0.08505 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="54" velocity="3.2" lower="-3.14159" upper="3.14159"/>
  </joint>

  <joint name="right_wrist_3_joint" type="revolute">
    <parent link="right_wrist_2_link"/>
    <child link="right_wrist_3_link"/>
    <origin xyz="0 0 0.08535" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="54" velocity="3.2" lower="-3.14159" upper="3.14159"/>
  </joint>

  <!-- Tool chain (fixed) -->
  <joint name="right_wrist_3_link-tool0_fixed_joint" type="fixed">
    <parent link="right_wrist_3_link"/>
    <child link="right_tool0"/>
    <origin xyz="0 0.0819 0" rpy="-1.5708 0 0"/>
  </joint>

  <joint name="right_ft300_fix" type="fixed">
    <parent link="right_tool0"/>
    <child link="right_ft300_mounting_plate"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="right_ft300_mounting_plate" type="fixed">
    <parent link="right_ft300_mounting_plate"/>
    <child link="right_ft300_sensor"/>
    <origin xyz="0 0 0.0415" rpy="3.14159 0 3.14159"/>
  </joint>

  <!-- Obstacles fixed to world -->
  <joint name="obs_world" type="fixed">
    <parent link="world"/>
    <child link="obs_box"/>
    <origin xyz="0.33933 0.047467 0.0376694" rpy="0 0 0"/>
  </joint>
  <joint name="obs_plat_world" type="fixed">
    <parent link="world"/>
    <child link="obs_box_platform"/>
    <origin xyz="0.43933 0.257467 0.472769" rpy="0 0 0"/>
  </joint>
  <joint name="obs_son_world" type="fixed">
    <parent link="world"/>
    <child link="obs_box_son"/>
    <origin xyz="0.33933 0.257467 0.377769" rpy="0 0 0"/>
  </joint>
  <joint name="other_box_1_world" type="fixed">
    <parent link="world"/>
    <child link="other_box_1"/>
    <origin xyz="0.543268 0.10939 -0.21" rpy="0 0 0"/>
  </joint>

</robot>