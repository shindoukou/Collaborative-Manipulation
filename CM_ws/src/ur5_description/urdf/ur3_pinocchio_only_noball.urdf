      <inertia ixx="0.002085" ixy="0" ixz="0" iyy="0.002085" iyz="0" izz="0.00225" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="/home/mas-2/catkin_gripper/src/ur3-master/ur3_description/meshes/ur3/visual/wrist2.dae" scale="1 1 1" />
      </geometry>
      <material name="LightGrey"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="/home/mas-2/catkin_gripper/src/ur3-master/ur3_description/meshes/ur3/collision/wrist2.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>

  <link name="right_wrist_3_link">
    <inertial>
      <mass value="0.35" />
      <origin xyz="0 0.0619 0" rpy="1.5708 0 0" />
      <inertia ixx="0.000136267" ixy="0" ixz="0" iyy="0.000136267" iyz="0" izz="0.0001792" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="/home/mas-2/catkin_gripper/src/ur3-master/ur3_description/meshes/ur3/visual/wrist3.dae" scale="1 1 1" />
      </geometry>
      <material name="LightGrey"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="/home/mas-2/catkin_gripper/src/ur3-master/ur3_description/meshes/ur3/collision/wrist3.stl" scale="1 1 1" />
