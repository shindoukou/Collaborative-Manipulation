  <link name="right_wrist_1_link">
    <inertial>
      <mass value="0.8" />
      <origin xyz="0 0.08505 0" rpy="0 0 0" />
      <inertia ixx="0.002085" ixy="0" ixz="0" iyy="0.002085" iyz="0" izz="0.00225" />
