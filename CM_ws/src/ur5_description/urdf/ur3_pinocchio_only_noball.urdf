  <link name="right_forearm_link">
    <inertial>
      <mass value="1.26" />
      <origin xyz="0 0 0.106625" rpy="0 0 0" />
      <inertia ixx="0.00654681" ixy="0" ixz="0" iyy="0.00654681" iyz="0" izz="0.00354375" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="/home/mas-2/catkin_gripper/src/ur3-master/ur3_description/meshes/ur3/visual/forearm.dae" scale="1 1 1" />
