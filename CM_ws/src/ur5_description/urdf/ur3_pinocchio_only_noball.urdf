<robot name="ur3_only">

  <!-- Materials -->
  <material name="LightGrey">
    <color rgba="0.7 0.7 0.7 1" />
  </material>
  <material name="Robotiq-Black">
    <color rgba="0.2 0.2 0.2 1" />
  </material>
  <material name="Robotiq-Grey">
    <color rgba="0.4 0.4 0.4 1" />
  </material>

  <!-- World -->
  <link name="world" />

  <!-- Right Arm Links -->
  <link name="right_base" />
  <link name="right_base_link">
