    <link name="obs_box1">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="100" />
      <inertia  ixx="100" ixy="0.0"  ixz="0.0"  
                iyy="100"  iyz="0.0"  izz="100" />
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.54 1.2 0.04"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.54 1.2 0.04"/>
      </geometry>
    </collision>
  </link>
  <!-- 左机械臂末端圆柱 -->
<link name="left_cylinder">
  <inertial>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
    <mass value="0.2"/>
    <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
    <geometry>
      <cylinder length="0.22" radius="0.05"/>
    </geometry>    <material name="blue">
      <color rgba="0 0 1 1"/>
    </material>
  </visual>
  <collision>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
    <geometry>
      <cylinder length="0.22" radius="0.05"/>
    </geometry>
  </collision>
</link>

<joint name="left_cylinder_joint" type="fixed">
  <parent link="left_tool0"/>
  <child link="left_cylinder"/>
  <origin xyz="0 0 0.07" rpy="0 0 0"/>
</joint>

<!-- 右机械臂末端圆柱 -->
<link name="right_cylinder">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.2"/>
    <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <cylinder length="0.2" radius="0.05"/>
    </geometry>
    <material name="red">
      <color rgba="1 0 0 1"/>
    </material>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <cylinder length="0.2" radius="0.05"/>
    </geometry>
  </collision>
</link>

<joint name="right_cylinder_joint" type="fixed">
  <parent link="right_tool0"/>
  <child link="right_cylinder"/>
  <origin xyz="0 0 0.12" rpy="0 0 0"/>
</joint>

  <joint name="obs_world1" type="fixed">
    <origin rpy="0 0 0.07" xyz="0.8 0.7 0.74"/>
    <parent link="world"/>
    <child link="obs_box1"/>
  </joint>
  
  <joint name="left_world_joint" type="fixed">
    <parent link="world" />
    <child link = "left_base_link" />
    <origin xyz="0.0 0.0 0.536214" rpy="0.0 0.0 0.0" />
  </joint>
  <joint name="right_world_joint" type="fixed">
    <parent link="world" />
    <child link = "right_base_link" />
    <origin xyz="0.01 0.629568 0.513699" rpy="0.0 0.00 3.1415926" />
  </joint>
  
  
  <xacro:left_robotiq_ft300 parent="left_tool0" prefix="left_">
    <origin xyz="0 0 0" rpy="0 0 0"/> 
  </xacro:left_robotiq_ft300>
  
  <xacro:right_robotiq_ft300 parent="right_tool0" prefix="right_">
    <origin xyz="0 0 0" rpy="0 0 0"/> 
  </xacro:right_robotiq_ft300>


    

  
  <!-- <joint name="left_banzi_joint" type="fixed">
    <parent link="left_ft300_sensor" />
    <child link = "left_cylinder" />
    <origin xyz="0.0 0.00 0.0" rpy="0 0 1.517" />
  </joint>
  <joint name="right_banzi_joint" type="fixed">
    <parent link="right_ft300_sensor" />
    <child link = "right_cylinder" />
    <origin xyz="0.0 0.00 0.0" rpy="0 0 1.517" />
  </joint> -->
  
  
   <gazebo>
    <plugin name="gazebo_grasp_fix" filename="libgazebo_grasp_fix.so">
      <arm>
        <arm_name>left_hand</arm_name>
        <palm_link>left_wrist_2_link</palm_link>
        <gripper_link>left_wrist_3_link</gripper_link>
      </arm>
      <arm>
        <arm_name>right_hand</arm_name>
        <palm_link>right_wrist_2_link</palm_link>
        <gripper_link>right_wrist_3_link</gripper_link>
      </arm>
        <forces_angle_tolerance>100</forces_angle_tolerance>
        <update_rate>2</update_rate>
        <grip_count_threshold>1</grip_count_threshold>
        <max_grip_count>2</max_grip_count>
        <release_tolerance>0.1</release_tolerance>
        <disable_collisions_on_attach>true</disable_collisions_on_attach>
        <contact_topic>__default_topic__</contact_topic>
    </plugin>
  </gazebo>
  
  <gazebo>
    <plugin filename="libgazebo_ros_control.so" name="ros_control">
      <!--robotNamespace>/</robotNamespace>
      <legacyModeNS>true</legacyModeNS-->
      <!--robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType-->
    </plugin>
  </gazebo>
  

  <!-- <gazebo reference="obs_box">
    <material>Gazebo/Green</material>
    <mu1>100000</mu1>
    <mu2>100000</mu2>
  </gazebo> -->
