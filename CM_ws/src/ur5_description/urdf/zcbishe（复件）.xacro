  </robot>

  
  <!-- gripper -->

  <xacro:robotiq_85_gripper prefix="right_" parent="right_tool0" >
    <origin xyz="0 0 0.04" rpy="0 -1.57 0"/>
  </xacro:robotiq_85_gripper> 
   <xacro:robotiq_85_gripper prefix="left_" parent="left_tool0" >
    <origin xyz="0 0 0.04" rpy="0 -1.57 0"/>
  </xacro:robotiq_85_gripper> 
  
  <!-- RGBD -->
  <!-- RGBD -->



  
  
  <!-- RGBD -->
    <xacro:sensor_d435 parent="right_tool0" use_nominal_extrinsics="$(arg use_nominal_extrinsics)">
    <origin xyz="-0.073 -0.009 0.0546" rpy="0.0 -1.57 0.0" />
  </xacro:sensor_d435>
  
  
