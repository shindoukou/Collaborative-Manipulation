<?xml version="1.0"?>
<robot name="combined_obstacles">

  <link name="base_link"/>

  <!-- ================================================================
       Robot Base Reference (左臂底座参考点)
       Position: xyz=(0, 0, 0.5)
       Geometry: sphere radius=0.025
       ================================================================ -->
  <joint name="joint_base_ref" type="fixed">
    <parent link="base_link"/>
    <child link="robot_base_ref"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>
  <link name="robot_base_ref">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="green">
        <color rgba="0.0 1.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
  </link>

  <!-- ================================================================
       Target Ball (弹性目标球)
       Source: launch file elastic_ball_0630.urdf
       Position: xyz=(0.560314844, 0.107087123, 0.602334435)
       Geometry: sphere radius=0.09
       ================================================================ -->
  <joint name="joint_target_ball" type="fixed">
    <parent link="base_link"/>
    <child link="target_ball"/>
    <origin xyz="0.560314844 0.107087123 0.602334435" rpy="0 0 0"/>
  </joint>
  <link name="target_ball">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.03375" ixy="0" ixz="0" iyy="0.03375" iyz="0" izz="0.03375"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.09"/></geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.09"/></geometry>
    </collision>
  </link>

  <!-- ================================================================
       Table (桌子)
       Source: launch file box_for_ball.urdf
       Position: xyz=(0.544814844, 0.107087123, 0.2723345)
       Geometry: box 0.35 x 0.6 x 0.53
       ================================================================ -->
  <joint name="joint_table" type="fixed">
    <parent link="base_link"/>
    <child link="table"/>
    <origin xyz="0.544814844 0.107087123 0.2723345" rpy="0 0 0"/>
  </joint>
  <link name="table">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.35 0.6 0.53"/></geometry>
      <material name="brown">
        <color rgba="0.6 0.3 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.35 0.6 0.53"/></geometry>
    </collision>
    <gazebo>
      <static>true</static>
    </gazebo>
  </link>

  <!-- ================================================================
       Obs Box Base (Xacro 内联障碍物)
       Source: ur5e_ur3_pinocchio_0406_new.xacro
       Position: xyz=(0.342, 0.034, 0.521)    [z = 0.021 + 0.5]
       Geometry: box 0.05 x 0.48 x 0.48
       ================================================================ -->
  <joint name="joint_obs_box_base" type="fixed">
    <parent link="base_link"/>
    <child link="obs_box_base"/>
    <origin xyz="0.342 0.034 0.521" rpy="0 0 0"/>
  </joint>
  <link name="obs_box_base">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.05 0.48 0.48"/></geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.05 0.48 0.48"/></geometry>
    </collision>
  </link>

  <!-- ================================================================
       Obs Box Son (Xacro 内联障碍物)
       Position: xyz=(0.342, 0.244, 0.861)    [z = 0.361 + 0.5]
       Geometry: box 0.05 x 0.06 x 0.20
       ================================================================ -->
  <joint name="joint_obs_box_son" type="fixed">
    <parent link="base_link"/>
    <child link="obs_box_son"/>
    <origin xyz="0.342 0.244 0.861" rpy="0 0 0"/>
  </joint>
  <link name="obs_box_son">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.05 0.06 0.20"/></geometry>
      <material name="orange_dark">
        <color rgba="0.8 0.4 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.05 0.06 0.20"/></geometry>
    </collision>
  </link>

  <!-- ================================================================
       Obs Box Platform (Xacro 内联障碍物)
       Position: xyz=(0.417, 0.257, 0.951)    [z = 0.451 + 0.5]
       Geometry: box 0.20 x 0.10 x 0.02
       ================================================================ -->
  <joint name="joint_obs_box_platform" type="fixed">
    <parent link="base_link"/>
    <child link="obs_box_platform"/>
    <origin xyz="0.417 0.257 0.951" rpy="0 0 0"/>
  </joint>
  <link name="obs_box_platform">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.20 0.10 0.02"/></geometry>
      <material name="gold">
        <color rgba="0.8 0.6 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.20 0.10 0.02"/></geometry>
    </collision>
  </link>

  <!-- ================================================================
       Left Wall (Xacro 内联障碍物 - 左侧墙)
       Position: xyz=(0.697, -0.398, 0.541)   [z = 0.041 + 0.5]
       Geometry: box 0.76 x 0.136 x 0.6
       ================================================================ -->
  <joint name="joint_left_wall" type="fixed">
    <parent link="base_link"/>
    <child link="left_wall"/>
    <origin xyz="0.697 -0.398 0.541" rpy="0 0 0"/>
  </joint>
  <link name="left_wall">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.76 0.136 0.6"/></geometry>
      <material name="cyan">
        <color rgba="0.2 0.6 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.76 0.136 0.6"/></geometry>
    </collision>
  </link>

  <!-- ================================================================
       Right Wall (Xacro 内联障碍物 - 右侧墙)
       Position: xyz=(0.697, 0.774, 0.501)    [z = 0.001 + 0.5]
       Geometry: box 0.76 x 0.22 x 0.6
       ================================================================ -->
  <joint name="joint_right_wall" type="fixed">
    <parent link="base_link"/>
    <child link="right_wall"/>
    <origin xyz="0.697 0.774 0.501" rpy="0 0 0"/>
  </joint>
  <link name="right_wall">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.76 0.22 0.6"/></geometry>
      <material name="cyan">
        <color rgba="0.2 0.6 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.76 0.22 0.6"/></geometry>
    </collision>
  </link>

  <!-- ================================================================
       Middle Wall (Xacro 内联障碍物 - 中间墙)
       Position: xyz=(1.182, 0.209, 0.501)    [z = 0.001 + 0.5]
       Geometry: box 0.05 x 1.35 x 0.6
       ================================================================ -->
  <joint name="joint_middle_wall" type="fixed">
    <parent link="base_link"/>
    <child link="middle_wall"/>
    <origin xyz="1.182 0.209 0.501" rpy="0 0 0"/>
  </joint>
  <link name="middle_wall">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.05 1.35 0.6"/></geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.05 1.35 0.6"/></geometry>
    </collision>
  </link>

  <!-- ================================================================
       Middle Inner Wall (Xacro 内联障碍物 - 中间内墙)
       Position: xyz=(1.010, 0.167, 0.501)    [z = 0.001 + 0.5]
       Geometry: box 0.135 x 0.994 x 0.6
       ================================================================ -->
  <joint name="joint_middle_inner_wall" type="fixed">
    <parent link="base_link"/>
    <child link="middle_inner_wall"/>
    <origin xyz="1.010 0.167 0.501" rpy="0 0 0"/>
  </joint>
  <link name="middle_inner_wall">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.135 0.994 0.6"/></geometry>
      <material name="blue_light">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.135 0.994 0.6"/></geometry>
    </collision>
  </link>

  <!-- ================================================================
       Gazebo settings: all obstacles static
       ================================================================ -->
  <gazebo reference="target_ball">
    <static>false</static>
  </gazebo>
  <gazebo reference="table">
    <static>true</static>
  </gazebo>
  <gazebo reference="obs_box_base">
    <static>true</static>
  </gazebo>
  <gazebo reference="obs_box_son">
    <static>true</static>
  </gazebo>
  <gazebo reference="obs_box_platform">
    <static>true</static>
  </gazebo>
  <gazebo reference="left_wall">
    <static>true</static>
  </gazebo>
  <gazebo reference="right_wall">
    <static>true</static>
  </gazebo>
  <gazebo reference="middle_wall">
    <static>true</static>
  </gazebo>
  <gazebo reference="middle_inner_wall">
    <static>true</static>
  </gazebo>

</robot>
