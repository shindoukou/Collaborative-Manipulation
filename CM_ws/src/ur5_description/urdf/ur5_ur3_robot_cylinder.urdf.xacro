<?xml version="1.0"?>
<robot name="double_ur5" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ur5_description)/urdf/left_ur5_joint_limited_robot.urdf.xacro" />
  <xacro:include filename="$(find ur5_description)/urdf/right_ur3_joint_limited_robot.urdf.xacro" />  
  <link name="world" />

  <link name="left_cylinder">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2" />
      <inertia  ixx="0.3375" ixy="0.0"  ixz="0.0"  iyy="0.3375"  iyz="0.0"  izz="0.3375" />
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"  rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.1"/>
      </geometry>
    </collision>
  </link>
  
  <link name="right_cylinder">
     <inertial>
      <origin xyz="0 0 0"  rpy="0 0 0"/>
      <mass value="0.2" />
      <inertia  ixx="0.3375" ixy="0.0"  ixz="0.0"  iyy="0.3375"  iyz="0.0"  izz="0.3375" />
    </inertial>
      <visual>
      <origin xyz="0 0 0"  rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.1"/>
      </geometry>
      </collision>
  </link>
  
  <joint name="left_world_joint" type="fixed">
    <parent link="world" />
    <child link = "left_base_link" />
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>
  <joint name="right_world_joint" type="fixed">
    <parent link="world" />
    <child link = "right_base_link" />
    <origin xyz="0.0 0.5 0.0" rpy="0.0 0.00 3.1415926" />
  </joint>

  
  <joint name="left_banzi_joint" type="fixed">
    <parent link="left_tool0" />
    <child link = "left_cylinder" />
    <origin xyz="0.0 0.00 0.0" rpy="0 0 1.517" />
  </joint>
    <joint name="right_banzi_joint" type="fixed">
    <parent link="right_tool0" />
    <child link = "right_cylinder" />
    <origin xyz="0.0 0.00 0.0" rpy="0 0 1.517" />
  </joint>
  <!--joint name="right_ball_joint" type="revolute">
    <parent link="right_wrist_3_link" />
    <child link = "elastic_ball" />
    <origin xyz="0.0 0.06 0.0" rpy="0.0 0.0 0" />
  </joint-->
  
  
  
  
   <gazebo>
    <plugin name="gazebo_grasp_fix" filename="libgazebo_grasp_fix.so">
      <arm>
        <arm_name>left_hand</arm_name>
        <palm_link>left_wrist_2_link</palm_link>
        <gripper_link>left_wrist_3_link</gripper_link>
      </arm>
      <arm>
        <arm_name>right_hand</arm_name>
        <palm_link>right_wrist_2_link</palm_link>
        <gripper_link>right_wrist_3_link</gripper_link>
      </arm>
        <forces_angle_tolerance>100</forces_angle_tolerance>
        <update_rate>2</update_rate>
        <grip_count_threshold>1</grip_count_threshold>
        <max_grip_count>2</max_grip_count>
        <release_tolerance>0.005</release_tolerance>
        <disable_collisions_on_attach>true</disable_collisions_on_attach>
        <contact_topic>__default_topic__</contact_topic>
    </plugin>
  </gazebo>
  
  <gazebo>
    <plugin filename="libgazebo_ros_control.so" name="ros_control">
      <!--robotNamespace>/</robotNamespace>
      <legacyModeNS>true</legacyModeNS-->
      <!--robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType-->
    </plugin>
  </gazebo>
  

  <gazebo reference="left_cylinder">
    <mu1>10000000000</mu1>
    <mu2>10000000000</mu2>
    <kp>1000000</kp>
  </gazebo>
  <gazebo reference="right_cylinder">
    <mu1>10000000000</mu1>
    <mu2>10000000000</mu2>
    <kp>1000000</kp>
  </gazebo>
  
</robot>
