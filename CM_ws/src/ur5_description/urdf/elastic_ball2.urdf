<?xml version='1.0'?>
<robot name="elastic_ball2">
  <link name="elastic_ball2">

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.0" />
      <inertia  ixx="0.3375" ixy="0.0"  ixz="0.0"  iyy="0.3375"  iyz="0.0"  izz="0.3375" />
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <sphere radius ="0.10"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <sphere radius ="0.10"/>
      </geometry>
    </collision>
  </link>
  
  <gazebo reference="elastic_ball2">
    <material> Gazebo/WoodPallet</material>
    <mu1>100000</mu1>
    <mu2>100000</mu2>
    <kp>10000</kp>
    <kd>1</kd>
  </gazebo>
  
  
  <gazebo>
    <static>true</static>
  </gazebo>
</robot>
<!--固定非障碍目标球 -->
