<?xml version="1.0"?>
<robot name="ur5e_ur3" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ur5_description)/urdf/left_ur5e_joint_limited_robot.urdf.xacro" />
  <xacro:include filename="$(find ur5_description)/urdf/right_ur3_joint_limited_robot.urdf.xacro"/>  
  <xacro:include filename="$(find robotiq_ft_sensor)/urdf/left_robotiq_ft300.urdf.xacro" />   
  <xacro:include filename="$(find robotiq_ft_sensor)/urdf/right_robotiq_ft300.urdf.xacro" /> 
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_85_gripper.urdf.xacro" />

  <xacro:include filename="$(find robotiq_2f_140_gripper_gazebo)/urdf/robotiq_arg2f_140_macro.xacro" />
  <xacro:arg name="transmission_hw_interface" default="hardware_interface/EffortJointInterface"/>
  <xacro:robotiq_arg2f_140_gazebo 
  prefix=""
  transmission_hw_interface="$(arg transmission_hw_interface)"/>

  <link name="world" />

  <!-- 障碍box -->
  <link name="table">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00003375" ixy="0.0" ixz="0.0" iyy="0.00003375" iyz="0.0" izz="0.00003375"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.55 1.21 0.7930"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.55 1.3 0.7930"/>
      </geometry>
    </collision>
  </link>
  <joint name="table_world" type="fixed">
    <!--remember +0.5 to z beacause the gazebo load -->
    <origin rpy="0 0 0" xyz="0.57002 0.1474 0.3715"/>
    <!-- 0.30 0.25 0.27 -->
    <parent link="world"/>
    <child link="table"/>
  </joint>
  <!-- 缝纫机 -->
  <link name="fengrenji">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00003375" ixy="0.0" ixz="0.0" iyy="0.00003375" iyz="0.0" izz="0.00003375"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.18 0.68 0.27"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.18 0.68 0.27"/>
      </geometry>
    </collision>
  </link>
  <joint name="fengrenji_world" type="fixed">
    <origin rpy="0 0 0" xyz="0.51502 -0.1131 0.9280"/>
    <parent link="world"/>
    <child link="fengrenji"/>
  </joint>



  <joint name="left_world_joint" type="fixed">
    <parent link="world" />
    <child link = "left_base_link" />
    <origin xyz="0.0 0.0 0.5628372064987123" rpy="0.0 0.0 0.0" />
  </joint>
  
  <joint name="right_world_joint" type="fixed">
    <parent link="world" />
    <child link = "right_base_link" />
    <origin xyz="-0.008 0.6298 0.5485198711692163" rpy="0.0 0.00 3.1415926" />
  </joint>
  
  
  
  <xacro:left_robotiq_ft300 parent="left_tool0" prefix="left_">
    <origin xyz="0 0 0" rpy="0 0 0"/> 
  </xacro:left_robotiq_ft300>
  
  <xacro:right_robotiq_ft300 parent="right_tool0" prefix="right_">
    <origin xyz="0 0 0" rpy="0 0 0"/> 
  </xacro:right_robotiq_ft300>

  <xacro:robotiq_85_gripper prefix="" parent="right_ft300_sensor" >
    <origin xyz="0 0 0.004" rpy="0 ${pi/2} ${pi}"/>
  </xacro:robotiq_85_gripper> 
    
  <joint name="left_gripper_joint" type="fixed">
    <parent link="left_ft300_sensor" />
    <child link = "base_link" />
    <origin xyz="0 0 0.004" rpy="0 ${pi} ${pi/2}" />
  </joint> 
  
  <!-- <joint name="left_banzi_joint" type="fixed">
    <parent link="left_ft300_sensor" />
    <child link = "left_cylinder" />
    <origin xyz="0.0 0.00 0.0" rpy="0 0 1.517" />
  </joint>
  <joint name="right_banzi_joint" type="fixed">
    <parent link="right_ft300_sensor" />
    <child link = "right_cylinder" />
    <origin xyz="0.0 0.00 0.0" rpy="0 0 1.517" />
  </joint> -->
  
  
   <gazebo>
    <plugin name="gazebo_grasp_fix" filename="libgazebo_grasp_fix.so">
      <arm>
        <arm_name>left_hand</arm_name>
        <palm_link>left_wrist_2_link</palm_link>
        <gripper_link>left_wrist_3_link</gripper_link>
      </arm>
      <arm>
        <arm_name>right_hand</arm_name>
        <palm_link>right_wrist_2_link</palm_link>
        <gripper_link>right_wrist_3_link</gripper_link>
      </arm>
        <forces_angle_tolerance>100</forces_angle_tolerance>
        <update_rate>2</update_rate>
        <grip_count_threshold>1</grip_count_threshold>
        <max_grip_count>2</max_grip_count>
        <release_tolerance>0.1</release_tolerance>
        <disable_collisions_on_attach>true</disable_collisions_on_attach>
        <contact_topic>__default_topic__</contact_topic>
    </plugin>
  </gazebo>
  
  <gazebo>
    <plugin filename="libgazebo_ros_control.so" name="ros_control">
      <!--robotNamespace>/</robotNamespace>
      <legacyModeNS>true</legacyModeNS-->
      <!--robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType-->
    </plugin>
  </gazebo>
  

  <!-- <gazebo reference="obs_box">
    <material>Gazebo/Green</material>
    <mu1>100000</mu1>
    <mu2>100000</mu2>
  </gazebo> -->
  <!-- <gazebo reference="other_box_1">
    <static>true</static>
    <material>Gazebo/Green</material>
    <mu1>100000</mu1>
    <mu2>100000</mu2>
  </gazebo> -->
  
</robot>
