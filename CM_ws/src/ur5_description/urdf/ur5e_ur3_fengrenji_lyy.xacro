<?xml version="1.0"?>
<robot name="ur5e_ur3" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ur5_description)/urdf/left_ur5e_joint_limited_robot.urdf.xacro" />
  <xacro:include filename="$(find ur5_description)/urdf/right_ur3_joint_limited_robot.urdf.xacro"/>  
  <xacro:include filename="$(find robotiq_ft_sensor)/urdf/left_robotiq_ft300.urdf.xacro" />   
  <xacro:include filename="$(find robotiq_ft_sensor)/urdf/right_robotiq_ft300.urdf.xacro" /> 
  <link name="world" />
  <link name="table">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia  ixx="0.00003375" ixy="0.0"  ixz="0.0"  iyy="0.00003375"  iyz="0.0"  izz="0.00003375" />
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.55 1.3 0.8016"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.55 1.3 0.8016"/>
      </geometry>
    </collision>
   </link>
   <joint name="table_world" type="fixed">
    <origin rpy="0 0 0" xyz="0.62198 0.33362 0.4008"/>
    <!-- 0.30 0.25 0.27 -->
    <parent link="world"/>
    <child link="table"/>
  </joint>
  <!-- 缝纫机 -->
  <link name="fengrenji">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia  ixx="0.00003375" ixy="0.0"  ixz="0.0"  iyy="0.00003375"  iyz="0.0"  izz="0.00003375" />
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.18 0.75 0.27"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.18 0.75 0.27"/>
      </geometry>
    </collision>
  </link>
  <joint name="fengrenji_world" type="fixed">
    <origin rpy="0 0 0" xyz="0.55698 0.08362 0.9366"/>
    <parent link="world"/>
    <child link="fengrenji"/>
  </joint>

  <joint name="left_world_joint" type="fixed">
    <parent link="world" />
    <child link = "left_base_link" />
    <origin xyz="0.0 0.0 0.5628372064987123" rpy="0.0 0.0 0.0" />
  </joint>
  
  <joint name="right_world_joint" type="fixed">
    <parent link="world" />
    <child link = "right_base_link" />
    <origin xyz="-0.008 0.6298 0.5485198711692163" rpy="0.0 0.00 3.1415926" />
  </joint>
  
  
  
  <xacro:left_robotiq_ft300 parent="left_tool0" prefix="left_">
    <origin xyz="0 0 0" rpy="0 0 0"/> 
  </xacro:left_robotiq_ft300>
  
  <xacro:right_robotiq_ft300 parent="right_tool0" prefix="right_">
    <origin xyz="0 0 0" rpy="0 0 0"/> 
  </xacro:right_robotiq_ft300>


  <link name="left_cylinder">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2" />
        <inertia  ixx="0.3375" ixy="0.0"  ixz="0.0"  iyy="0.3375"  iyz="0.0"  izz="0.3375" />
      </inertial>

      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.0532" radius="0.0375"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0"  rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.0532" radius="0.0375"/>
        </geometry>
      </collision>
  </link>

  <joint name="left_cylinder_left_ft300" type="fixed">
    <origin rpy="0 3.14 0" xyz="0 0 -0.0266"/>
    <parent link="left_ft300_sensor"/>
    <child link="left_cylinder"/>
  </joint>


<link name="gripper140">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia  ixx="0.00003375" ixy="0.0"  ixz="0.0"  iyy="0.00003375"  iyz="0.0"  izz="0.00003375" />
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.18 0.21 0.035"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.18 0.21 0.035"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper140_left_cylinder" type="fixed">
    <origin rpy="0 1.57 0" xyz="0 0 0.1166"/>
    <parent link="left_cylinder"/>
    <child link="gripper140"/>
  </joint>



  <link name="right_cylinder">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2" />
        <inertia  ixx="0.3375" ixy="0.0"  ixz="0.0"  iyy="0.3375"  iyz="0.0"  izz="0.3375" />
      </inertial>
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.0532" radius="0.0375"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0"  rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.0532" radius="0.0375"/>
        </geometry>
      </collision>
  </link>

   <joint name="left_cylinder_right_ft300" type="fixed">
    <origin rpy="0 3.14 0" xyz="0 0 -0.0266"/>
    <parent link="right_ft300_sensor"/>
    <child link="right_cylinder"/>
  </joint>

    <link name="gripper85">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia  ixx="0.00003375" ixy="0.0"  ixz="0.0"  iyy="0.00003375"  iyz="0.0"  izz="0.00003375" />
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.113 0.153 0.035"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.113 0.153 0.035"/>
      </geometry>
    </collision>
  </link>
    <joint name="gripper85_right_cylinder" type="fixed">
    <origin rpy="0 1.5707 0" xyz="0 0 0.0831"/>
    <parent link="right_cylinder"/>
    <child link="gripper85"/>
  </joint>

  
  
