  <!-- 障碍box -->
  <!-- 障碍box -->
  <link name="obs_box">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="100"/>
      <inertia ixx="100" ixy="0.0" ixz="0.0" iyy="100" iyz="0.0" izz="100"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.8 1.5 0.2"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.8 1.5 0.2"/>
      </geometry>
    </collision>
  </link>
  <joint name="obs_world" type="fixed">
    <origin rpy="0 0 0" xyz="0.4 0.45 -0.35"/>
    <parent link="world"/>
    <child link="obs_box"/>
  </joint>
  <joint name="left_world_joint" type="fixed">
    <parent link="world"/>
    <child link="left_base_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
  </joint>
  <joint name="right_world_joint" type="fixed">
    <parent link="world"/>
    <child link="right_base_link"/>
    <origin rpy="0.0 0.00 3.1415926" xyz="0.013888969 0.470583541 -0.001"/>
  </joint>
