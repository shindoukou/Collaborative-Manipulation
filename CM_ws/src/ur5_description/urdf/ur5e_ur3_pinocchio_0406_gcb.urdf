      <inertia ixx="0.00013626661215999998" ixy="0.0" ixz="0.0" iyy="0.00013626661215999998" iyz="0.0" izz="0.0001792"/>
    </inertial>
  </link>
  <joint name="right_ee_fixed_joint" type="fixed">
    <parent link="right_wrist_3_link"/>
    <child link="right_ee_link"/>
    <origin rpy="0.0 0.0 1.5707963267948966" xyz="0.0 0.0819 0.0"/>
  </joint>
  <link name="right_ee_link">
    <collision>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <origin rpy="0 0 0" xyz="-0.01 0 0"/>
    </collision>
  </link>
  <transmission name="right_shoulder_pan_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_shoulder_pan_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_shoulder_pan_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="right_shoulder_lift_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_shoulder_lift_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_shoulder_lift_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="right_elbow_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_elbow_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_elbow_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="right_wrist_1_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_wrist_1_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_wrist_1_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="right_wrist_2_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_wrist_2_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_wrist_2_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="right_wrist_3_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_wrist_3_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_wrist_3_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <gazebo reference="right_shoulder_link">
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="right_upper_arm_link">
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="right_forearm_link">
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="right_wrist_1_link">
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="right_wrist_3_link">
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="right_wrist_2_link">
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="right_ee_link">
    <selfCollide>true</selfCollide>
  </gazebo>
  <!-- ROS base_link to UR 'Base' Coordinates transform -->
  <link name="right_base"/>
  <joint name="right_base_link-base_fixed_joint" type="fixed">
    <!-- NOTE: this rotation is only needed as long as base_link itself is
                 not corrected wrt the real robot (ie: rotated over 180
                 degrees)
      -->
    <origin rpy="0 0 -3.141592653589793" xyz="0 0 0"/>
    <parent link="right_base_link"/>
    <child link="right_base"/>
  </joint>
  <!-- Frame coincident with all-zeros TCP on UR controller -->
  <link name="right_tool0"/>
  <joint name="right_wrist_3_link-tool0_fixed_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0.0819 0"/>
    <parent link="right_wrist_3_link"/>
    <child link="right_tool0"/>
  </joint>
  <!-- 在左右机械臂的tool0与夹爪之间添加圆柱体连接件 -->
  <!-- 右机械臂部分 -->
  <link name="right_cylinder">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.04"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.04" radius="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_cylinder_joint" type="fixed">
    <parent link="right_tool0"/>
    <child link="right_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- 左机械臂部分 -->
  <link name="left_cylinder">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.04"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.04" radius="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_cylinder_joint" type="fixed">
    <parent link="left_tool0"/>
    <child link="left_cylinder"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- 右机械臂夹爪 -->
  <link name="right_grp">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.17" radius="0.08"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.17" radius="0.08"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_grp_joint" type="fixed">
    <parent link="right_cylinder"/>
    <child link="right_grp"/>
    <origin rpy="0 0 0" xyz="0 0 0.105"/>
  </joint>
  <!-- 左机械臂夹爪 -->
  <link name="left_grp">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.17" radius="0.08"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.17" radius="0.08"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_grp_joint" type="fixed">
    <parent link="left_cylinder"/>
    <child link="left_grp"/>
    <origin rpy="0 0 0" xyz="0 0 0.105"/>
  </joint>
  <link name="world"/>
