<?xml version="1.0"?>
<launch>
  














  <env name="GAZEBO_MODEL_PATH"
       value="$(find cm_trajectory_generation)/models/box:$(optenv GAZEBO_MODEL_PATH)"/>

  <arg name="grasp_plugin_lib_dir"
       default="$(env HOME)/catkin_gripper/devel/lib"/>
  <env name="GAZEBO_PLUGIN_PATH"
       value="$(arg grasp_plugin_lib_dir):$(optenv GAZEBO_PLUGIN_PATH)"/>
  <env name="LD_LIBRARY_PATH"
       value="$(arg grasp_plugin_lib_dir):$(optenv LD_LIBRARY_PATH)"/>

  <arg name="paused" default="true"/>
  <arg name="debug" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="rate" default="125"/>
  <arg name="world_name" default="worlds/empty.world"/>

  <arg name="robot_z" default="0.5"/>
  <arg name="box_x" default="0.5379895"/>
  <arg name="box_y" default="0.0969192"/>
  <arg name="box_z" default="0.619375445"/>
  <arg name="box_yaw" default="0.0"/>

  
  <arg name="table_x" default="0.62986639"/>
  <arg name="table_y" default="0.167242173"/>
  <arg name="table_z" default="0.303875445"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <param name="robot_description"
         command="$(find xacro)/xacro --inorder '$(find cm_trajectory_generation)/models/box/urdf/ur5e_ur3_kirara_box_gazebo.xacro'"/>

  <node name="spawn_cm_trajectory_generation_robot"
        pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf -param robot_description -model robot
              -J left_shoulder_pan_joint -1.256637061
              -J left_shoulder_lift_joint -1.5707
              -J left_elbow_joint 1.5707
              -J left_wrist_1_joint -1.5707
              -J right_shoulder_pan_joint 1.256637061
              -J right_shoulder_lift_joint -1.5707
              -J right_elbow_joint -1.5707
              -J right_wrist_1_joint -1.5707
              -z $(arg robot_z)"/>

  
  <node name="spawn_cm_trajectory_generation_object"
        pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf -file $(find cm_trajectory_generation)/models/box/urdf/box_220mm_kirara_box.urdf
              -model cm_trajectory_generation_object
              -x $(arg box_x) -y $(arg box_y) -z $(arg box_z)
              -Y $(arg box_yaw)"/>

  <node name="spawn_cm_trajectory_generation_table"
        pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf -file $(find cm_trajectory_generation)/models/box/urdf/box_for_ball_kirara_box.urdf
              -model cm_trajectory_generation_table
              -x $(arg table_x) -y $(arg table_y) -z $(arg table_z)"/>

  <rosparam file="$(find cm_trajectory_generation)/config/box/ur5e_ur3_controller.yaml"
            command="load"/>
  <node name="robot_controllers" pkg="controller_manager" type="spawner"
        output="screen"
        args="all_joint_state_controller left_trajectory_controller right_trajectory_controller"/>

</launch>
