<?xml version="1.0"?>
<launch>
  <!-- Gazebo layout for the dual-arm ball experiment. -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(find cm_trajectory_generation)/models/ball:$(optenv GAZEBO_MODEL_PATH)"/>

  <arg name="paused" default="true"/>
  <arg name="debug" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="rate" default="125"/>
  <arg name="world_name" default="worlds/empty.world"/>
  <arg name="sim" default="true"/>
  <arg name="grasp_plugin_lib_dir"
       default="$(env HOME)/catkin_gripper/devel/lib"/>

  <!-- gazebo_grasp_fix and its companion libraries are built in the
       dedicated gripper workspace on the target machine.  Keep both the
       Gazebo plugin search path and the dynamic linker path explicit so that
       sourcing CM_ws cannot hide the grasp plugin overlay. -->
  <env name="GAZEBO_PLUGIN_PATH"
       value="$(arg grasp_plugin_lib_dir):$(optenv GAZEBO_PLUGIN_PATH)"/>
  <env name="LD_LIBRARY_PATH"
       value="$(arg grasp_plugin_lib_dir):$(optenv LD_LIBRARY_PATH)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <param name="robot_description"
         command="$(find xacro)/xacro --inorder '$(find cm_trajectory_generation)/models/ball/urdf/gazebo_newbase.xacro'"/>

  <!-- One dual-arm robot model, not separate left/right robot models. -->
  <node name="spawn_gazebo_model" pkg="gazebo_ros" type="spawn_model"
        output="screen"
        args="-urdf -param robot_description -model robot
              -J left_shoulder_pan_joint -1.256637061
              -J left_shoulder_lift_joint -1.5707
              -J left_elbow_joint 1.5707
              -J left_wrist_1_joint -1.5707
              -J left_wrist_2_joint 0.0
              -J left_wrist_3_joint 0.0
              -J right_shoulder_pan_joint 1.256637061
              -J right_shoulder_lift_joint -1.5707
              -J right_elbow_joint -1.5707
              -J right_wrist_1_joint -1.5707
              -J right_wrist_2_joint 0.0
              -J right_wrist_3_joint 0.0
              -z 0.5"/>

  <node name="ball" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -file $(find cm_trajectory_generation)/models/ball/urdf/elastic_ball_0630.urdf
              -x 0.47823221 -y 0.21454345 -z 0.658875445
              -model elastic_ball3"/>
  <!-- Keep the free ball 20 mm above the Catch endpoint's two-hand midpoint
       to compensate the measured grasp-attachment offset during Move. -->
  <node name="table" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -file $(find cm_trajectory_generation)/models/ball/urdf/box_for_ball.urdf
              -x 0.62986639 -y 0.167242173 -z 0.303875445
              -model table"/>

  <rosparam file="$(find cm_trajectory_generation)/config/ball/ur5e_ur3_controller.yaml"
            command="load"/>
  <node name="robot_controllers" pkg="controller_manager" type="spawner"
        output="screen"
        args="all_joint_state_controller left_trajectory_controller right_trajectory_controller"/>
</launch>
