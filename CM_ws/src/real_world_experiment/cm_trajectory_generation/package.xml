<?xml version="1.0"?>
<package format="2">
  <name>cm_trajectory_generation</name>
  <version>0.1.0</version>
  <description>Distributed dual-arm goal search and trajectory generation with object-specific scenes.</description>
  <maintainer email="mas-2@todo.todo">mas-2</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>kdl_parser</depend>
  <depend>moveit_msgs</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
