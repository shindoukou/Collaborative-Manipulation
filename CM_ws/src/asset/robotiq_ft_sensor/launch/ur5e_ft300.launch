<?xml version="1.0"?>
<launch>
  <arg name="serial_id" default="ttyUSB1"/>
  <group ns="left_ft300">
    <node name="ft_sensor" pkg="robotiq_ft_sensor" type="rq_sensor" output="screen">
      <param name="frame_id" type="str" value="ur5e"/>
      <param name="serial_id" type="str" value="$(arg serial_id)"/>
    </node>
  </group>
</launch>
