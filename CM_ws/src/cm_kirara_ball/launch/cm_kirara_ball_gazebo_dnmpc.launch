<?xml version="1.0"?>
<launch>
  <arg name="paused" default="true"/>
  <arg name="gui" default="true"/>

  <!-- Ball simulation always starts paused. Resume it manually in Gazebo only
       after the robot, controllers, and both DNMPC nodes are ready. -->
  <include file="$(find cm_kirara_ball)/launch/ball_newbase.launch">
    <arg name="paused" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>
</launch>
