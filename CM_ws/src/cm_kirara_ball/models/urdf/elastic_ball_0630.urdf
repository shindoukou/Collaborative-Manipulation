<?xml version='1.0'?>
<robot name="elastic_ball3">
  <link name="elastic_ball3">

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.020" />
      <inertia  ixx="0.03375" ixy="0.0"  ixz="0.0"  iyy="0.03375"  iyz="0.0"  izz="0.03375" />
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <sphere radius ="0.09"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <sphere radius ="0.09"/>
      </geometry>
    </collision>
  </link>
  
  <gazebo reference="elastic_ball3">
    <material> Gazebo/Red</material>
    <mu1>100000000000</mu1>
    <mu2>100000000000</mu2>
    <kp>10000</kp>

  </gazebo>
  
  
  <gazebo>
    <static>false</static>
  </gazebo>
</robot>
