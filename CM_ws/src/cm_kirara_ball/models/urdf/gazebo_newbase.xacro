  <!-- 障碍box -->
 <!-- 障碍box -->
  <link name="obs_box">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia  ixx="0.00003375" ixy="0.0"  ixz="0.0"  iyy="0.00003375"  iyz="0.0"  izz="0.00003375" />
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.05 0.48 0.190476114"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.05 0.48 0.190476114"/>
      </geometry>
    </collision>
   </link>
   <joint name="obs_world" type="fixed">
    <!-- Shift the complete obstacle assembly 20 mm toward -y. Keep this
         link's top fixed and its bottom 2 mm above the raised ball table. -->
    <origin rpy="0 0 0" xyz="0.34236639 0.014242173 0.166113502"/>
    <!--0.339329853 0.047467049 -0.202330619-->
    <!-- 0.037669381 -->
    <parent link="world"/>
    <child link="obs_box"/>
  </joint>
  <!-- 障碍box儿子 -->
  <link name="obs_box_son">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia  ixx="0.00003375" ixy="0.0"  ixz="0.0"  iyy="0.00003375"  iyz="0.0"  izz="0.00003375" />
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.05 0.06 0.20"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.05 0.06 0.20"/>
      </geometry>
    </collision>
  </link>
  <joint name="obs_son_parent" type="fixed">
    <!-- The son's bottom is exactly coincident with the main box's top. -->
    <origin rpy="0 0 0" xyz="0 0.21 0.195238057"/>
    <!--0.339329853 0.047467049 -0.202330619-->
    <!-- 0.037669381 -->
    <parent link="obs_box"/>
    <child link="obs_box_son"/>
  </joint>
  <!-- 障碍box平台 -->
  <link name="obs_box_platform">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia  ixx="0.00003375" ixy="0.0"  ixz="0.0"  iyy="0.00003375"  iyz="0.0"  izz="0.00003375" />
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.2 0.10 0.02"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.2 0.10 0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="obs_plat_son" type="fixed">
    <!-- Shift the platform with the complete obstacle assembly toward -y. -->
    <origin rpy="0 0 0" xyz="0.075 0.013224876 0.09"/>
    <!-- <origin rpy="0 0 0" xyz="0.439329853 0.257467049 0.472769381"/> -->
    <parent link="obs_box_son"/>
    <child link="obs_box_platform"/>
  </joint>


   <!-- 障碍box_left -->
  <link name="obs_box_left">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia  ixx="0.00003375" ixy="0.0"  ixz="0.0"  iyy="0.00003375"  iyz="0.0"  izz="0.00003375" />
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.76 0.136 0.6"/>
      </geometry>
    </visual>


    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.76 0.136 0.6"/>
      </geometry>
    </collision>


   </link>
   <joint name="obs_left_world" type="fixed">
    <origin rpy="0 0 0" xyz="0.69736639 -0.397757827 0.041351559"/>
    <parent link="world"/>
    <child link="obs_box_left"/>
  </joint>

   <!-- 障碍box_right -->
  <link name="obs_box_right">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia  ixx="0.00003375" ixy="0.0"  ixz="0.0"  iyy="0.00003375"  iyz="0.0"  izz="0.00003375" />
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.76 0.22 0.6"/>
      </geometry>
    </visual>


    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.76 0.22 0.6"/>
      </geometry>
    </collision>

   </link>
   <joint name="obs_right_world" type="fixed">
    <origin rpy="0 0 0" xyz="0.69736639 0.774242173 0.001351559"/>
    <parent link="world"/>
    <child link="obs_box_right"/>
  </joint>

   <!-- 障碍box_middle -->
  <link name="obs_box_middle">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia  ixx="0.00003375" ixy="0.0"  ixz="0.0"  iyy="0.00003375"  iyz="0.0"  izz="0.00003375" />
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.05 1.35 0.6"/>
      </geometry>
    </visual>


    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.05 1.35 0.6"/>
      </geometry>
    </collision>

   </link>
   <joint name="obs_middle_world" type="fixed">
    <origin rpy="0 0 0" xyz="1.18236639 0.209242173 0.001351559"/>
    <parent link="world"/>
    <child link="obs_box_middle"/>
  </joint>
     <!-- 障碍box_middle_in -->
  <link name="obs_box_middle_in">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.1" />
      <inertia  ixx="0.00003375" ixy="0.0"  ixz="0.0"  iyy="0.00003375"  iyz="0.0"  izz="0.00003375" />
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.135 0.994 0.6"/>
      </geometry>
    </visual>


    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size ="0.135 0.994 0.6"/>
      </geometry>
    </collision>

   </link>
   <joint name="obs_middle_in_world" type="fixed">
    <origin rpy="0 0 0" xyz="1.00986639 0.167242173 0.001351559"/>
    <parent link="world"/>
    <child link="obs_box_middle_in"/>
  </joint>
